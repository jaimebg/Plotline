# Secrets
Secrets.xcconfig
Plotline/Secrets.plist

# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
# Plotline.xcodeproj/xcshareddata/ (shared schemes) is versioned on purpose:
# the UI test target's <TestAction> entry, its parallelizable setting and the
# Archive pre-action that runs the release preflight all live there, and none
# of them would exist outside one machine otherwise. Step 7 of
# Scripts/release-preflight.sh reads every scheme in that directory and fails
# if any declares an environment variable with a value, so a leaked secret is
# caught there instead of by never versioning the file.
#
# The workspace's own xcshareddata/ is a different thing — per-checkout
# workspace settings, nothing shared worth versioning — so it stays ignored.
Plotline.xcodeproj/project.xcworkspace/xcshareddata/

# CocoaPods
Pods/

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store

# IDE
*.xcworkspace/xcuserdata/

# SDD scratch workspace (subagent-driven-development)
.superpowers/

# App Store screenshots: raw captures are intermediate, regenerable by
# Scripts/screenshots/capture.sh, and about 25 MB. screenshots/<version>/ —
# the composed frames actually uploaded to App Store Connect — is committed.
screenshots/raw/

# Fastlane: local-only, never committed. The directory holds an App Store
# Connect .p8 upload credential, the issuer id, and review-contact details
# (phone, email) that have no business in a public repo. The store copy in
# fastlane/metadata/ is therefore unversioned too — a known, accepted cost,
# recorded in docs/superpowers/specs/2026-08-10-app-store-automation-design.md.
# The *recipe* lives in docs/app-review/README.md, and docs/ is gitignored
# below — local-only by the same reasoning.
fastlane/

# docs/ — local-only: App Review notes, Resolution Center replies, store copy
# rationale, plans and specs. Kept on disk, kept out of the public repo.
docs/
